# PayPal sandbox REST app credentials (https://developer.paypal.com/dashboard/)
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
# Anthropic API key
ANTHROPIC_API_KEY=your-anthropic-key
# Optional
AI_MODEL=claude-sonnet-5-5
AUTO_SEND_LIMIT=500
# PayPal webhook id (developer dashboard > your app > Webhooks); enables /api/webhooks/paypal
PAYPAL_WEBHOOK_ID=your-webhook-id
# Shared secret Zapier sends as x-settle-secret to POST /api/jobs
ZAPIER_HOOK_SECRET=change-me
# Zapier Catch Hook URL that Settle calls when an invoice is paid
ZAPIER_PAID_HOOK_URL=https://hooks.zapier.com/hooks/catch/000000/xxxxxx/
