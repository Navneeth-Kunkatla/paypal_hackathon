{
  "info": {
    "name": "Countersign",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Countersign: the guardrail layer for PayPal agents, shown on invoicing. Routes for the mandate, the audit trail and the invoice agent, plus direct PayPal sandbox calls."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "settleSecret",
      "value": ""
    },
    {
      "key": "invoiceId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Countersign API",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"shape\", () => { const j = pm.response.json(); pm.expect(j).to.have.property(\"paypal\"); pm.expect(j).to.have.property(\"ai\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "description": "Which keys are configured.",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          }
        },
        {
          "name": "List invoices",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"invoices array\", () => pm.expect(pm.response.json().invoices).to.be.an(\"array\"));",
                  "const first = pm.response.json().invoices[0]; if (first) pm.environment.set(\"invoiceId\", first.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "description": "Lists PayPal sandbox invoices and detects newly paid ones. Saves the first id to invoiceId.",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/invoices",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "invoices"
              ]
            }
          }
        },
        {
          "name": "Send invoice (approve draft)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"ok\", () => pm.expect(pm.response.json().ok).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "description": "Human approval of a DRAFT invoice. Sends it for real in the sandbox.",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}/send",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "invoices",
                "{{invoiceId}}",
                "send"
              ]
            }
          }
        },
        {
          "name": "Remind invoice",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"ok\", () => pm.expect(pm.response.json().ok).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "description": "Sends a PayPal reminder for a sent invoice.",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}/remind",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "invoices",
                "{{invoiceId}}",
                "remind"
              ]
            }
          }
        },
        {
          "name": "Activity log",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"events array\", () => pm.expect(pm.response.json().events).to.be.an(\"array\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "description": "Agent activity, newest first.",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/activity",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "activity"
              ]
            }
          }
        },
        {
          "name": "Get mandate",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"four clauses\", () => { const j = pm.response.json(); [\"autoSendLimit\",\"dailyCap\",\"newClientNeedsApproval\",\"maxReminders\"].forEach(k => pm.expect(j).to.have.property(k)); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "description": "The mandate: what the agent may do without asking (per-invoice limit, daily cap, new-client rule, reminder cap).",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/settings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "settings"
              ]
            }
          }
        },
        {
          "name": "Update mandate",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"autoSendLimit\", () => pm.expect(pm.response.json().autoSendLimit).to.be.a(\"number\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "description": "Change the mandate. Send any of the four fields; each change is recorded in the audit trail.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/settings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "settings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"autoSendLimit\": 500,\n  \"dailyCap\": 2000,\n  \"newClientNeedsApproval\": false,\n  \"maxReminders\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Audit trail",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"entries array\", () => pm.expect(pm.response.json().entries).to.be.an(\"array\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "description": "One row per attempted send, reminder, cancel or mandate change: who, action, verdict (allowed, held, blocked), the rule that decided and why. Newest first.",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/audit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "audit"
              ]
            }
          }
        },
        {
          "name": "Audit trail CSV",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"csv\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/csv\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "description": "The same rows as a CSV download.",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/audit?format=csv",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "audit"
              ],
              "query": [
                {
                  "key": "format",
                  "value": "csv"
                }
              ]
            }
          }
        },
        {
          "name": "Chat",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200 or 503\", () => pm.expect(pm.response.code).to.be.oneOf([200, 503]));",
                  "pm.test(\"503 has error\", () => { if (pm.response.code === 503) pm.expect(pm.response.json().error).to.be.a(\"string\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "description": "Agent chat, AI SDK data stream. 503 when keys are missing.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Who owes me money?\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Jobs (Zapier inbound)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200/503\", () => pm.expect(pm.response.code).to.be.oneOf([200, 503]));",
                  "pm.test(\"shape\", () => { const j = pm.response.json(); if (pm.response.code === 200) { pm.expect(j.ok).to.eql(true); pm.expect(j.summary).to.be.a(\"string\"); } else pm.expect(j.error).to.be.a(\"string\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "description": "Job done: agent creates and sends an invoice. Needs x-settle-secret.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-settle-secret",
                "value": "{{settleSecret}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/jobs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "jobs"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_name\": \"Acme Ltd\",\n  \"client_email\": \"billing@example.com\",\n  \"amount\": \"120\",\n  \"description\": \"Logo design\",\n  \"due_days\": 14,\n  \"currency\": \"USD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Chase overdue",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200/503\", () => pm.expect(pm.response.code).to.be.oneOf([200, 503]));",
                  "pm.test(\"shape\", () => { const j = pm.response.json(); if (pm.response.code === 200) { pm.expect(j.ok).to.eql(true); pm.expect(j.reminded).to.be.a(\"number\"); pm.expect(j.summary).to.be.a(\"string\"); } else pm.expect(j.error).to.be.a(\"string\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "description": "Reminds every overdue invoice. Returns immediately when nothing is overdue.",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/chase",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chase"
              ]
            }
          }
        },
        {
          "name": "List clients",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200/500\", () => pm.expect(pm.response.code).to.be.oneOf([200, 500]));",
                  "pm.test(\"shape\", () => { const j = pm.response.json(); if (pm.response.code === 200) pm.expect(j.clients).to.be.an(\"array\"); else pm.expect(j.error).to.be.a(\"string\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "description": "Per-client roll-up of PayPal invoices.",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/clients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clients"
              ]
            }
          }
        },
        {
          "name": "Summarize clients",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200/502/503\", () => pm.expect(pm.response.code).to.be.oneOf([200, 502, 503]));",
                  "pm.test(\"shape\", () => { const j = pm.response.json(); if (pm.response.code === 200) pm.expect(j.summary).to.be.a(\"string\"); else pm.expect(j.error).to.be.a(\"string\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "description": "One Gemini call over the client stats. Plain text.",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/clients/summary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clients",
                "summary"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "PayPal Sandbox (direct)",
      "item": [
        {
          "name": "Get OAuth token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"token\", () => pm.expect(pm.response.json().access_token).to.be.a(\"string\"));",
                  "pm.environment.set(\"paypalToken\", pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "description": "Client credentials grant. Set paypalClientId and paypalClientSecret in the environment first.",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{paypalClientId}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{paypalClientSecret}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                }
              ]
            },
            "url": {
              "raw": "https://api-m.sandbox.paypal.com/v1/oauth2/token",
              "protocol": "https",
              "host": [
                "api-m",
                "sandbox",
                "paypal",
                "com"
              ],
              "path": [
                "v1",
                "oauth2",
                "token"
              ]
            }
          }
        },
        {
          "name": "List invoices",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"items\", () => pm.expect(pm.response.json()).to.have.property(\"items\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "description": "Lists sandbox invoices.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{paypalToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://api-m.sandbox.paypal.com/v2/invoicing/invoices?page_size=10&fields=all",
              "protocol": "https",
              "host": [
                "api-m",
                "sandbox",
                "paypal",
                "com"
              ],
              "path": [
                "v2",
                "invoicing",
                "invoices?page_size=10&fields=all"
              ]
            }
          }
        },
        {
          "name": "Create draft invoice",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"has href\", () => pm.expect(pm.response.json().href).to.be.a(\"string\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "description": "Creates a DRAFT invoice (not sent).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{paypalToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://api-m.sandbox.paypal.com/v2/invoicing/invoices",
              "protocol": "https",
              "host": [
                "api-m",
                "sandbox",
                "paypal",
                "com"
              ],
              "path": [
                "v2",
                "invoicing",
                "invoices"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"detail\": {\n    \"currency_code\": \"USD\",\n    \"payment_term\": {\n      \"due_date\": \"2026-12-31\"\n    }\n  },\n  \"primary_recipients\": [\n    {\n      \"billing_info\": {\n        \"name\": {\n          \"given_name\": \"Test\",\n          \"surname\": \"Client\"\n        },\n        \"email_address\": \"client@example.com\"\n      }\n    }\n  ],\n  \"items\": [\n    {\n      \"name\": \"Logo design\",\n      \"quantity\": \"1\",\n      \"unit_amount\": {\n        \"currency_code\": \"USD\",\n        \"value\": \"120.00\"\n      }\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get invoice",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"id matches\", () => pm.expect(pm.response.json().id).to.eql(pm.variables.get(\"invoiceId\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "description": "Fetch one invoice by id (set invoiceId via Countersign API > List invoices).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{paypalToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://api-m.sandbox.paypal.com/v2/invoicing/invoices/{{invoiceId}}",
              "protocol": "https",
              "host": [
                "api-m",
                "sandbox",
                "paypal",
                "com"
              ],
              "path": [
                "v2",
                "invoicing",
                "invoices",
                "{{invoiceId}}"
              ]
            }
          }
        }
      ]
    }
  ]
}
